#!/bin/bash

################################
# PROMPT
################################

# Colors
BLACK="$(tput setaf 0)"
RED="$(tput setaf 1)"
GREEN="$(tput setaf 2)"
YELLOW="$(tput setaf 3)"
BLUE="$(tput setaf 4)"
PURPLE="$(tput setaf 5)"
CYAN="$(tput setaf 6)"
WHITE="$(tput setaf 7)"
GREY="$(tput setaf 8)"
# Extended Colors
BRIGHT_RED="$(tput setaf 9)"
BRIGHT_GREEN="$(tput setaf 10)"
BRIGHT_YELLOW="$(tput setaf 11)"
BRIGHT_BLUE="$(tput setaf 12)"
BRIGHT_PURPLE="$(tput setaf 13)"
BRIGHT_CYAN="$(tput setaf 14)"
BRIGHT_WHITE="$(tput setaf 15)"
# Other formatting
BOLD="$(tput bold)"
RESET="$(tput sgr0)"

# Prompt vars
# git-prompt from git
. ~/.git-prompt.sh
GIT_PS1_SHOWCOLORHINTS=yes
GIT_PS1_SHOWDIRTYSTATE=1

# FULL_PS1 - default
export FULL_PS1='$(__git_ps1 "(%s)")\[${RESET}\][\[${BRIGHT_PURPLE}\]\t\[${RESET}\]-\[${BRIGHT_BLUE}\]\u\[${RESET}\]@\[${BRIGHT_GREEN}\]\h\[${RESET}\]:\[${BRIGHT_YELLOW}\]\w\[${RESET}\]]$ '
export MINI_PS1='\[${RESET}\][\[${BRIGHT_GREEN}\]\h\[${RESET}\]:\[${BRIGHT_YELLOW}\]\W\[${RESET}\]]$ '
prompt_size () {
    unset PROMPT_COMMAND
    local sz=${1^^}_PS1
    export PS1=${!sz}
}
prompt_size full

################################
# PROMPT
################################
# ~/.bashrc loads this in
if command -v tmux &> /dev/null && [ -n "$PS1" ] && [[ ! "$TERM" =~ screen ]] && [[ ! "$TERM" =~ tmux ]] && [ -z "$TMUX" ]; then
    if tmux list-sessions &> /dev/null ; then
        tmux attach\; choose-tree -swZ 
    else
        tmux -f ~/.tmux.conf
    fi
fi

export QHOME=~/q/v4.1/
export KHOME=~/k
if ! [[ "$PATH" =~ "${QHOME}/l64" ]] ; then
    export PATH=${PATH}:${QHOME}/l64; 
fi

if ! [[ "$PATH" =~ "$KHOME" ]] ; then
    export PATH=$PATH:$KHOME
fi

################################
# ALIASES
################################
alias vim='nvim'
alias q='rlwrap q'
#alias k='rlwrap k'
source ~/.kubectl_completion
alias k=kubectl
complete -F __start_kubectl k
